<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" 
        xmlns:tizen="http://tizen.org/ns/widgets" 
        id="http://ottking.top/TestWebViewApp" 
        version="1.0.0" 
        viewmodes="maximized">
        
    <tizen:application id="tizen.TestWebViewApp" package="TestWebViewApp" required_version="3.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <icon src="icon.png"/>
    <name>Test WebView App</name>
    
    <!-- Privileges (Permissions) -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
    <tizen:privilege name="http://tizen.org/privilege/mediacontroller.client"/>
    
    <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="disable" encryption="disable" install-location="auto"/>
    <tizen:profile name="tv"/>
</widget>
